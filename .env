# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Database (docker-compose.yml reads these too) ----
POSTGRES_USER=lf
POSTGRES_PASSWORD=3NQuFYwGa2W4DlzNGG2MKMHoXPQv0ZWE
POSTGRES_DB=lostfound
POSTGRES_PORT=5442
DATABASE_URL=postgresql+psycopg://lf:3NQuFYwGa2W4DlzNGG2MKMHoXPQv0ZWE@127.0.0.1:5442/lostfound
# Used only by the automated tests. They create and drop tables here, so never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://lf:3NQuFYwGa2W4DlzNGG2MKMHoXPQv0ZWE@127.0.0.1:5442/lostfound_test

# ---- API ----
# Origins allowed to call the API from a browser (comma-separated). The Next.js proxy is same-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Secret for hashing visitor fingerprints (IP + browser) for anti-spam. Raw IPs are never stored.
FINGERPRINT_SECRET=JtY8wYCjQqgUVAgJA4jSTUslbGYtbQrm0gl0bd0njfQ
# Bearer token for /internal/* endpoints. Leave empty to disable those endpoints entirely.
SERVICE_TOKEN=
# Include the hand-written demo dataset in API results (true for the FYP demo, false for real-only).
SHOW_DEMO_DATA=false
READ_RATE_PER_MINUTE=120
SUGGESTION_RATE_PER_HOUR=5

# ---- Ollama Cloud (worker only) ----
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=4a2a72e0d5214b229f6f226f577a1fd3.4OnQgrxfupLvQuJgEgBSK8A4
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=2048
# Set to false only for models that have a thinking mode (e.g. qwen3). Leave empty otherwise.
OLLAMA_THINK=
AI_MAX_JOBS_PER_MINUTE=4

# ---- Geocoding (OpenStreetMap Nominatim; 1 request/second, results cached) ----
GEOCODER_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LostAndFoundFinder-dev/0.1 (university final year project)

# ---- Collection sources (each connector stays off until its credentials are set) ----
SOURCES_CONFIG=config/sources.yaml
# X API v2 (pay-per-use). Leave empty to keep the X connector off.
X_BEARER_TOKEN=
# Reddit Data API (requires Reddit's approval). Leave empty to keep it off.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Bluesky: a free account handle and an app password (Settings Ã¢â€ â€™ App passwords).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
AI_PROVIDER=openrouter
OPENROUTER_MODEL=recursive/flint-v1.0:free
OPENROUTER_API_KEY=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
